#!/bin/bash
# Git Pre-Commit Hook: Constitutional Enforcement
# Prevents commits that violate project laws

# Colors
RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m'

echo -e "${YELLOW}⚖️  Constitutional Pre-Commit Check${NC}"

# Get staged files
STAGED_FILES=$(git diff --cached --name-only)

if [[ -z "$STAGED_FILES" ]]; then
    exit 0
fi

VIOLATIONS_FOUND=false

# ── LAW 18: Constitutional Database Integrity ────────────────────
# Run law-manage.py validate if any .claude/ files are staged
CONSTITUTIONAL_FILES=$(echo "$STAGED_FILES" | grep -E '^\.claude/' || true)
if [[ -n "$CONSTITUTIONAL_FILES" ]]; then
    if command -v python3 &>/dev/null && [[ -f ".claude/bin/law-manage.py" ]]; then
        echo ""
        echo -e "${YELLOW}⚖️  LAW 18: Constitutional Database Integrity${NC}"
        if ! python3 .claude/bin/law-manage.py validate 2>&1; then
            echo ""
            echo -e "${RED}✗ LAW 18 VIOLATION: Constitutional drift detected${NC}"
            echo "  Run: python3 .claude/bin/law-manage.py regenerate"
            echo "  Then: python3 .claude/bin/law-manage.py validate"
            VIOLATIONS_FOUND=true
        fi
    fi
fi

# Check LAW 2: Documentation First
CODE_FILES=$(echo "$STAGED_FILES" | grep -E '\.(sh|py|js|go|rs)$' || true)
if [[ -n "$CODE_FILES" ]]; then
    # Accept docs/ OR .claude/ markdown as valid documentation updates
    DOC_FILES=$(echo "$STAGED_FILES" | grep -E '(docs/.*\.md$|\.claude/.*\.md$)' || true)
    if [[ -z "$DOC_FILES" ]]; then
        echo -e "${RED}✗ LAW 2 VIOLATION: Documentation First${NC}"
        echo "  Code files changed without docs updates:"
        echo "$CODE_FILES" | sed 's/^/    - /'
        echo ""
        echo "  Required: Update corresponding docs/*.md files"
        VIOLATIONS_FOUND=true
    fi
fi

# Check LAW 4: Navigation Standards (TOC + BTT)
MD_FILES=$(echo "$STAGED_FILES" | grep '\.md$' || true)
for md_file in $MD_FILES; do
    if [[ -f "$md_file" ]]; then
        LINE_COUNT=$(wc -l < "$md_file")
        if [[ $LINE_COUNT -gt 150 ]]; then
            if ! grep -q "## Table of Contents" "$md_file"; then
                echo -e "${RED}✗ LAW 4 VIOLATION: Navigation Standards${NC}"
                echo "  File: $md_file ($LINE_COUNT lines)"
                echo "  Missing: Table of Contents"
                VIOLATIONS_FOUND=true
            fi
            if ! grep -q "\[↑ Back to Top\]" "$md_file"; then
                echo -e "${RED}✗ LAW 4 VIOLATION: Navigation Standards${NC}"
                echo "  File: $md_file ($LINE_COUNT lines)"
                echo "  Missing: Back to Top buttons"
                VIOLATIONS_FOUND=true
            fi
        fi
    fi
done

# ── LAW 28: Additive Evolution — Protected File Deletion Check ───
# Protected files are append-only. Net line deletions are a LAW 28 violation.
PROTECTED_PATTERNS="docs/accretion.md|MEMORY.md|.claude/SESSION_CONTEXT.md|.claude/LESSONS-LEARNED.md|.claude/FOUNDATIONS.md|.claude/PROJECT_LAWS.md"
PROTECTED_STAGED=$(echo "$STAGED_FILES" | grep -E "($PROTECTED_PATTERNS)" || true)
if [[ -n "$PROTECTED_STAGED" ]]; then
    echo ""
    echo -e "${YELLOW}⚖️  LAW 28: Additive Evolution — Protected File Check${NC}"
    while IFS= read -r pfile; do
        if [[ -n "$pfile" ]]; then
            LINES_ADDED=$(git diff --cached --numstat "$pfile" 2>/dev/null | awk '{print $1}')
            LINES_REMOVED=$(git diff --cached --numstat "$pfile" 2>/dev/null | awk '{print $2}')
            LINES_ADDED=${LINES_ADDED:-0}
            LINES_REMOVED=${LINES_REMOVED:-0}
            if [[ "$LINES_REMOVED" -gt 0 ]]; then
                NET=$(( LINES_ADDED - LINES_REMOVED ))
                if [[ "$NET" -lt 0 ]]; then
                    echo -e "${RED}✗ LAW 28 VIOLATION: Net deletion in protected file${NC}"
                    echo "  File: $pfile"
                    echo "  Added: +$LINES_ADDED  Removed: -$LINES_REMOVED  Net: $NET"
                    echo "  Protected files are append-only. Prior form is data."
                    echo "  Review your edit: new content must include all prior content."
                    VIOLATIONS_FOUND=true
                else
                    echo -e "${YELLOW}  ⚠ $pfile: -$LINES_REMOVED lines removed (+$LINES_ADDED added, net +$NET) — verify no prior content was lost${NC}"
                fi
            else
                echo -e "${GREEN}  ✓ $pfile: additive only (+$LINES_ADDED lines)${NC}"
            fi
        fi
    done <<< "$PROTECTED_STAGED"
fi

# Check file format quality (JSON, YAML, CSV)
echo ""
echo -e "${YELLOW}⚖️  File Format Validation${NC}"

# Run test-audit if it exists
if [[ -x ".claude/.test-audit/test-audit.sh" ]]; then
    # Only validate staged files (not all files in repo)
    FORMAT_FILES=$(echo "$STAGED_FILES" | grep -E '\.(json|yaml|yml|csv)$' || true)

    if [[ -n "$FORMAT_FILES" ]]; then
        # Temporarily save staged format files for validation
        TEMP_TEST_DIR=$(mktemp -d)
        while IFS= read -r file; do
            if [[ -f "$file" ]]; then
                mkdir -p "$TEMP_TEST_DIR/$(dirname "$file")"
                cp "$file" "$TEMP_TEST_DIR/$file"
            fi
        done <<< "$FORMAT_FILES"

        # Run test-audit on staged files only
        # Note: For now, we run on all files. Future enhancement: validate only staged files
        if ! .claude/.test-audit/test-audit.sh > /dev/null 2>&1; then
            echo -e "${RED}✗ FILE FORMAT VIOLATION: Syntax errors detected${NC}"
            echo "  Run: ./.claude/.test-audit/test-audit.sh"
            echo "  Check: .claude/.test-audit/test-audit.log"
            echo ""
            VIOLATIONS_FOUND=true
        else
            echo -e "${GREEN}✓ All file formats valid${NC}"
        fi

        # Cleanup
        rm -rf "$TEMP_TEST_DIR"
    else
        echo -e "${GREEN}✓ No format files to validate${NC}"
    fi
else
    echo -e "${YELLOW}⊘ test-audit.sh not found (skipped)${NC}"
fi

if [[ "$VIOLATIONS_FOUND" == "true" ]]; then
    echo ""
    echo -e "${RED}⚖️  COMMIT BLOCKED BY CONSTITUTIONAL ENFORCEMENT${NC}"
    echo "Fix violations above, then try again."
    echo ""
    echo "See: .claude/PROJECT_LAWS.md"
    echo ""
    echo -e "${YELLOW}⚖️  LAW 20 — Human Sovereignty${NC}"
    echo "  If you have authority to override: git commit --no-verify"
    exit 1
else
    echo -e "${GREEN}✓ All constitutional requirements met${NC}"
    exit 0
fi
